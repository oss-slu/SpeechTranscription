{
  "meta": {
    "name": "Saltify 2.0 design tokens",
    "issue": "https://github.com/oss-slu/SpeechTranscription/issues/361",
    "version": "0.1.0",
    "notes": [
      "This file is the single source of truth. Run `python scripts/build_design_tokens.py` to regenerate design-tokens.css.",
      "Every key becomes a CSS custom property: \"color-bg-app\" -> var(--color-bg-app).",
      "Light and dark themes must define exactly the same keys. Components use semantic names only, never raw hex values.",
      "contrastPairs are enforced by tests/test_design_tokens.py in both themes."
    ]
  },

  "base": {
    "font-family-sans": "\"Inter\", \"Segoe UI Variable Text\", \"Segoe UI\", -apple-system, BlinkMacSystemFont, \"SF Pro Text\", system-ui, sans-serif",
    "font-family-mono": "\"JetBrains Mono\", \"Cascadia Mono\", \"SF Mono\", Menlo, Consolas, monospace",

    "font-weight-regular": "400",
    "font-weight-medium": "500",
    "font-weight-semibold": "600",
    "font-weight-bold": "700",

    "font-size-caption": "12px",
    "line-height-caption": "16px",
    "font-size-label": "13px",
    "line-height-label": "18px",
    "font-size-body": "14px",
    "line-height-body": "20px",
    "font-size-transcript": "16px",
    "line-height-transcript": "26px",
    "font-size-title-sm": "16px",
    "line-height-title-sm": "24px",
    "font-size-title": "20px",
    "line-height-title": "28px",
    "font-size-heading": "24px",
    "line-height-heading": "32px",
    "font-size-display": "28px",
    "line-height-display": "36px",
    "transcript-max-width": "72ch",

    "space-0": "0px",
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
    "space-5": "20px",
    "space-6": "24px",
    "space-8": "32px",
    "space-10": "40px",
    "space-12": "48px",

    "radius-sm": "6px",
    "radius-md": "8px",
    "radius-lg": "12px",
    "radius-xl": "16px",
    "radius-pill": "999px",

    "border-width": "1px",
    "focus-ring-width": "2px",
    "focus-ring-offset": "2px",

    "target-min": "24px",
    "target-default": "32px",
    "target-primary": "40px",
    "target-transport": "44px",

    "shell-titlebar-height": "40px",
    "shell-titlebar-inset-macos": "80px",
    "shell-sidebar-width": "232px",
    "shell-sidebar-rail-width": "64px",
    "shell-list-width": "248px",
    "shell-inspector-width": "320px",
    "shell-inspector-width-compact": "288px",
    "shell-main-min-width": "480px",
    "shell-window-min-width": "1024px",
    "shell-window-min-height": "640px",

    "motion-duration-fast": "120ms",
    "motion-duration-base": "180ms",
    "motion-duration-slow": "260ms",
    "motion-easing-standard": "cubic-bezier(0.2, 0, 0, 1)",
    "motion-easing-exit": "cubic-bezier(0.3, 0, 1, 1)",

    "z-sidebar": "10",
    "z-sticky": "20",
    "z-dropdown": "100",
    "z-overlay": "200",
    "z-dialog": "300",
    "z-toast": "400",
    "z-tooltip": "500"
  },

