  "contrastPairs": {
    "text": {
      "minimum": 4.5,
      "pairs": [
        ["color-text-primary", "color-bg-app"],
        ["color-text-primary", "color-bg-surface"],
        ["color-text-primary", "color-bg-surface-raised"],
        ["color-text-primary", "color-bg-sidebar"],
        ["color-text-primary", "color-bg-hover"],
        ["color-text-primary", "color-bg-selected"],
        ["color-text-secondary", "color-bg-app"],
        ["color-text-secondary", "color-bg-surface"],
        ["color-text-secondary", "color-bg-surface-sunken"],
        ["color-text-secondary", "color-bg-hover"],
        ["color-text-muted", "color-bg-surface"],
        ["color-text-muted", "color-bg-surface-raised"],
        ["color-text-muted", "color-bg-app"],
        ["color-text-muted", "color-bg-surface-sunken"],
        ["color-text-muted", "color-bg-selected"],
        ["color-text-link", "color-bg-surface"],
        ["color-text-link", "color-bg-app"],
        ["color-text-selected", "color-bg-selected"],
        ["color-on-accent", "color-accent-primary"],
        ["color-on-accent", "color-accent-primary-hover"],
        ["color-on-accent", "color-accent-primary-pressed"],
        ["color-on-accent", "color-accent-record"],
        ["color-on-accent", "color-accent-record-hover"],
        ["color-on-accent", "color-accent-import"],
        ["color-on-accent", "color-accent-import-hover"],
        ["color-status-success-fg", "color-status-success-bg"],
        ["color-status-info-fg", "color-status-info-bg"],
        ["color-status-review-fg", "color-status-review-bg"],
        ["color-status-warning-fg", "color-status-warning-bg"],
        ["color-status-danger-fg", "color-status-danger-bg"],
        ["color-status-neutral-fg", "color-status-neutral-bg"],
        ["color-status-warning-fg", "color-bg-surface"],
        ["color-error-text", "color-bg-surface"],
        ["color-speaker-1-fg", "color-speaker-1-bg"],
        ["color-speaker-2-fg", "color-speaker-2-bg"],
        ["color-speaker-3-fg", "color-speaker-3-bg"],
        ["color-speaker-4-fg", "color-speaker-4-bg"],
        ["color-speaker-5-fg", "color-speaker-5-bg"],
        ["color-speaker-6-fg", "color-speaker-6-bg"]
