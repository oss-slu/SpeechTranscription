        ["color-focus-ring", "color-bg-surface"],
        ["color-focus-ring", "color-bg-app"],
        ["color-focus-ring", "color-bg-sidebar"],
        ["color-border-strong", "color-bg-surface"],
        ["color-border-strong", "color-bg-surface-sunken"],
        ["color-accent-primary", "color-bg-surface"],
        ["color-error-border", "color-bg-surface"],
        ["color-speaker-1-solid", "color-bg-surface"],
        ["color-speaker-2-solid", "color-bg-surface"],
        ["color-speaker-3-solid", "color-bg-surface"],
        ["color-speaker-4-solid", "color-bg-surface"],
        ["color-speaker-5-solid", "color-bg-surface"],
        ["color-speaker-6-solid", "color-bg-surface"],
        ["color-waveform-played", "color-bg-surface"],
